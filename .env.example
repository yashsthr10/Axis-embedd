# Copy to .env and adjust for your environment.
# cp .env.example .env

# Python
PYTHONPATH=src

# Training
TINYEMBED_EXPERIMENT=experiment_001
TINYEMBED_TRAIN_CONFIG=configs/train.yaml

# Inference / deployment
TINYEMBED_MODEL_PATH=deployment/export
TINYEMBED_PORT=8000
TINYEMBED_HOST=0.0.0.0
TINYEMBED_DEVICE=cuda
TINYEMBED_QUANTIZATION=none
TINYEMBED_CUDA_KERNELS=false
TINYEMBED_MAX_BATCH_SIZE=32
TINYEMBED_MAX_SEQ_LENGTH=512

# Data paths
TINYEMBED_DATA_DIR=data
TINYEMBED_CORPUS_PATH=data/final/train.jsonl

# CUDA build (optional)
CUDA_HOME=/usr/local/cuda
TORCH_CUDA_ARCH_LIST=8.0;8.6;9.0
